                <ui:Label text="Current program nodes : " name="PrgInfoTxt" style="font-size: 22px; height: auto; width: auto; background-color: rgba(255, 255, 255, 0); color: rgb(0, 0, 0); -unity-font-style: bold; top: auto; right: auto; position: absolute; left: auto; margin-left: 4px; padding-left: 4px; padding-right: 4px; margin-bottom: 4px;"/>
            </ui:ScrollView>
        </ui:VisualElement>
        <ui:VisualElement name="ProgramMenu" style="flex-grow: 1; position: absolute; width: 600px; height: 1030px; visibility: visible; top: 50px;">
            <ui:VisualElement name="NodeSelector" style="flex-grow: 1; position: absolute; width: 200px; height: 1030px; background-color: rgb(255, 255, 255); border-top-width: 0; border-right-width: 3px; border-right-color: rgb(0, 0, 0);">
                <ui:Foldout text="Basic" value="true" name="BasicMenu" toggle-on-label-click="true" style="font-size: 24px; -unity-font-style: bold;">
                    <ui:Button text="Move" name="MoveButton" style="height: 20px; font-size: 18px;"/>
                    <ui:Button text="Waypoint" name="WaypointButton" style="height: 20px; font-size: 18px;"/>
