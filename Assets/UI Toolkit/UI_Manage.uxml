            <ui:Label text="2FG Grip :" name="GripTitle" style="align-items: auto; align-self: flex-start; font-size: 32px; -unity-font-style: bold; -unity-text-align: upper-left; left: 60px; top: -7px;"/>
            <ui:VisualElement name="GripWidthWindow" style="flex-grow: 0; width: 308px; height: 67px;">
                <ui:FloatField label="Width :" value="60" name="GripWidth" style="top: 10px; font-size: 24px; -unity-font-style: bold; height: 45px; width: 235px; overflow: visible; flex-direction: row; right: 20px; margin-top: 0; margin-left: 0; margin-right: 0; margin-bottom: 0; -unity-text-align: middle-center;">
                    <ui:Label text="mm" name="GripWidthUnits" style="left: 235px; position: absolute; top: 0;"/>
                </ui:FloatField>
