<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/ButtonStyle.uss?fileID=7433441132597879392&amp;guid=1f79e3bfec4e3b8459245db91927f493&amp;type=3#ButtonStyle"/>
    <ui:VisualElement name="Main_Interface" style="flex-grow: 1; aspect-ratio: auto; display: flex;">
        <ui:Button text="Program" name="ProgramMenuButton" data-source-path="" enabled="true" class="ButtonStyle" style="position: absolute; align-self: center; align-items: auto; align-content: auto; justify-content: flex-start; -unity-text-align: middle-center; top: -2px; left: -2px; white-space: pre; width: 250px; -unity-font-style: bold; font-size: 24px; background-color: rgb(59, 71, 255); right: auto; height: 50px; color: rgb(255, 255, 255); border-right-color: rgb(0, 0, 0); border-right-width: 3px; margin-top: 0; margin-right: 0; margin-left: 0; margin-bottom: 0; padding-top: 0; padding-right: 0; padding-left: 0; padding-bottom: 0; display: flex;"/>
        <ui:Button text="Move" name="MoveMenuButton" data-source-path="" enabled="true" class="ButtonStyle" style="position: absolute; align-self: center; align-items: auto; align-content: auto; justify-content: flex-start; -unity-text-align: middle-center; top: -2px; left: 248px; white-space: pre; width: 250px; -unity-font-style: bold; font-size: 24px; background-color: rgb(59, 71, 255); right: auto; height: 50px; color: rgb(255, 255, 255); border-right-color: rgb(0, 0, 0); border-right-width: 3px; border-left-color: rgb(0, 0, 0); border-left-width: 3px; margin-top: 0; padding-top: 0; padding-right: 0; margin-right: 0; padding-bottom: 0; margin-bottom: 0; margin-left: 0; padding-left: 0;"/>
        <ui:Button text="Robot Info" name="ShowCobotInfo" data-source-path="" class="ButtonStyle" style="position: absolute; align-self: auto; align-items: auto; align-content: auto; justify-content: flex-start; -unity-text-align: middle-center; top: 20px; left: auto; white-space: pre-wrap; width: 250px; -unity-font-style: bold; font-size: 24px; background-color: rgb(255, 255, 255); height: 50px; right: 20px;"/>
        <ui:VisualElement name="PrintInfo" style="flex-grow: 1; display: flex; visibility: visible; position: absolute; top: 60px; width: 1920px; height: 1020px;">
            <ui:Label text=" Tool Info : " name="ToolInfoText" style="font-size: 22px; height: 290px; width: 460px; background-color: rgba(255, 255, 255, 0.314); color: rgb(0, 0, 0); -unity-font-style: bold; top: 350px; right: 20px; position: absolute;"/>
            <ui:Label text=" Joints info :&#10;&#x9;q1 = -000.000&#x9;q2 = -000.000&#10;&#x9;q3 = -000.000&#x9;q4 = -000.000&#10;&#x9;q5 = -000.000&#x9;q6 = -000.000" name="JointInfoText" style="font-size: 22px; height: 120px; width: 520px; -unity-font-style: bold; color: rgb(0, 0, 0); position: absolute; bottom: 20px; left: 970px; background-color: rgba(255, 255, 255, 0.314);"/>
